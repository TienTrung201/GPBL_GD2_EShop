# Chuy?n hu?ng HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name mshop-api.itrung.online;

    location / {
        return 301 https://$host$request_uri;
    }
}

# C?u hình HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mshop-api.itrung.online;

    ssl_certificate /etc/letsencrypt/live/mshop-api.itrung.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mshop-api.itrung.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://localhost:5000;  # Ch?y API trên c?ng 5000
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
